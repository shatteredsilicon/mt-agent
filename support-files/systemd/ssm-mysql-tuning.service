[Unit]
Description=SSM MySQL/MariaDB Tuning
ConditionFileIsExecutable=/opt/ss/ssm-client/mt-agent
After=network.target
After=syslog.target

[Service]
StartLimitInterval=5
StartLimitBurst=10
ExecStart=/opt/ss/ssm-client/mt-agent

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=ssm-mysql-tuning

Restart=always
RestartSec=120

[Install]
WantedBy=multi-user.target